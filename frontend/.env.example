# ==============================================================================
# Edu-Voice-Ai — Frontend Environment Configuration Example
# ==============================================================================
# Copy this file to .env.local and replace placeholder values.
# NEVER include secret keys (like service-role keys or provider private keys) here.
# All NEXT_PUBLIC_ variables are bundled and exposed to the browser client.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CLIENT CONFIGURATION (PUBLIC / SAFE)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=<YOUR_SUPABASE_URL>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<YOUR_SUPABASE_PUBLISHABLE_KEY>

# Alternate standard naming fallback if needed
PUBLIC_SUPABASE_URL=<YOUR_SUPABASE_URL>
PUBLIC_SUPABASE_PUBLISHABLE_KEY=<YOUR_SUPABASE_PUBLISHABLE_KEY>

# ------------------------------------------------------------------------------
# 2. BACKEND API BASE URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# 3. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Edu-Voice AI"
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
