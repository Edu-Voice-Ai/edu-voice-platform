# ==============================================================================
# Edu-Voice-Ai — Backend Environment Configuration Example
# ==============================================================================
# Copy this file to .env and replace placeholder values with your credentials.
# NEVER commit real .env files with secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="Edu-Voice-Ai Backend"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & AUTHENTICATION (SERVER SECRETS)
# ------------------------------------------------------------------------------
# Supabase project URL & publishable key placeholders
SUPABASE_URL=https://ccydagfljcdnkkobyhwx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_8lvXhuJamTZ2xmlwCulnTw_N8q2mdLq

# Supabase Service Role Key (NEVER expose to frontend clients!)
# Used by backend to perform privileged operations (e.g. background sync, worker jobs)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Supabase JWT Secret (Used by FastAPI to verify JWT tokens from Supabase Auth)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Direct / Pooled PostgreSQL connection string for SQLAlchemy / asyncpg
# e.g., postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:<DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ------------------------------------------------------------------------------
# 3. LLM ENGINE (GROQ)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=1024

# ------------------------------------------------------------------------------
# 4. EMBEDDINGS & RAG (BAAI/bge-m3)
# ------------------------------------------------------------------------------
# Embeddings dimension: 1024 dimensions for BAAI/bge-m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.65

# ------------------------------------------------------------------------------
# 5. VOICE ENGINE (SEPARATE CONTAINER / SERVICE)
# ------------------------------------------------------------------------------
# Voice Engine runs as a dedicated high-performance container with GPU acceleration
# (Silero VAD v5 + Parakeet-TDT STT + Qwen3-TTS + CUDA)
VOICE_ENGINE_URL=http://localhost:8001
VOICE_ENGINE_API_KEY=your_internal_voice_engine_secret_token
VOICE_ENGINE_TIMEOUT_SECONDS=10

# ------------------------------------------------------------------------------
# 6. TELEPHONY PROVIDER (EXOTEL) & INTERNAL SERVICE SECURITY
# ------------------------------------------------------------------------------
INTERNAL_SERVICE_KEY=your_internal_shared_service_key_for_voice_gateway
EXOTEL_ACCOUNT_SID=your_exotel_account_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_SUB_DOMAIN=api.exotel.com
EXOTEL_CALLER_ID=+91XXXXXXXXXX
EXOTEL_WEBHOOK_SECRET=your_exotel_webhook_verification_secret

# ------------------------------------------------------------------------------
# 7. AWS INFRASTRUCTURE & STORAGE
# ------------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_DOCUMENTS=edu-voice-documents-dev
S3_BUCKET_RECORDINGS=edu-voice-recordings-dev
