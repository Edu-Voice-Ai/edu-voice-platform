# ==============================================================================
# Edu-Voice-Ai — Root Environment Configuration Overview
# ==============================================================================
# This workspace contains multiple services:
# - Frontend: See `frontend/.env.example` -> `frontend/.env.local`
# - Backend:  See `backend/.env.example`  -> `backend/.env`
#
# Core Supabase Placeholders for local configuration:
# ==============================================================================

# Public / Client-Safe Keys:
SUPABASE_URL=<YOUR_SUPABASE_URL>
SUPABASE_PUBLISHABLE_KEY=<YOUR_SUPABASE_PUBLISHABLE_KEY>
PUBLIC_SUPABASE_URL=<YOUR_SUPABASE_URL>
PUBLIC_SUPABASE_PUBLISHABLE_KEY=<YOUR_SUPABASE_PUBLISHABLE_KEY>

# Server / Secret Keys (Backend only, NEVER expose to frontend):
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# GROQ_API_KEY=your_groq_api_key
# EXOTEL_API_KEY=your_exotel_api_key
