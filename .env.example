# ==============================================================================
# Edu-Voice-AI — Environment Variable Template
# ==============================================================================
# IMPORTANT: This file contains ONLY variable placeholders and safe defaults.
# NEVER commit real credentials, tokens, passwords, or private keys to Git.
# ==============================================================================

# ==============================================================================
# 1. APPLICATION ENVIRONMENT
# ==============================================================================
# VARIABLE:     ENVIRONMENT
# PURPOSE:      Defines runtime execution mode ('development', 'test', 'production')
# REQUIRED FOR: All environments
# TYPE:         NON-SECRET
# SOURCE:       Local developer shell / Dockerfile / AWS ECS Task Definition
ENVIRONMENT=development


# ==============================================================================
# 2. LOCAL TEST CONFIGURATION (YASIN GATEWAY)
# ==============================================================================
# All settings below provide safe local defaults for local development and CI testing.

# VARIABLE:     BACKEND_INTERNAL_URL
# PURPOSE:      Base URL for internal FastAPI service-to-service calls (DID resolution)
# REQUIRED FOR: BackendPhoneAssignmentResolver
# TYPE:         NON-SECRET
# SOURCE:       .env / Docker Compose / AWS VPC Service Discovery
BACKEND_INTERNAL_URL=http://localhost:8000

# VARIABLE:     INTERNAL_SERVICE_KEY
# PURPOSE:      Shared secret key passed in X-Internal-Service-Key header
# REQUIRED FOR: Internal service-to-service authentication
# TYPE:         SECRET (Dummy value for local dev; injected via AWS Secrets Manager in production)
# SOURCE:       AWS Secrets Manager (Production) / .env (Local Dev)
INTERNAL_SERVICE_KEY=your_generated_64char_random_hex_token

# VARIABLE:     DID_RESOLVE_TIMEOUT_MS
# PURPOSE:      Request timeout in milliseconds for DID resolution calls
# REQUIRED FOR: BackendPhoneAssignmentResolver
# TYPE:         NON-SECRET (integer milliseconds)
# SOURCE:       .env (default: 2000)
DID_RESOLVE_TIMEOUT_MS=2000

# VARIABLE:     TELEPHONY_SIGNATURE_VERIFICATION_ENABLED
# PURPOSE:      Toggles HMAC signature checking on incoming webhooks (set to false only in local mock testing if needed)
# REQUIRED FOR: Telephony Webhook Router
# TYPE:         NON-SECRET (boolean)
# SOURCE:       .env / Docker Compose
TELEPHONY_SIGNATURE_VERIFICATION_ENABLED=true

# VARIABLE:     TELEPHONY_WEBHOOK_SECRET
# PURPOSE:      HMAC-SHA256 secret key for telecom webhook signature verification
# REQUIRED FOR: Inbound webhook verification
# TYPE:         SECRET (Dummy value for local dev; injected via AWS Secrets Manager in production)
# SOURCE:       AWS Secrets Manager (Production) / .env (Local Dev)
TELEPHONY_WEBHOOK_SECRET=your_telephony_webhook_hmac_secret_here

# VARIABLE:     TELEPHONY_WEBHOOK_TOLERANCE_SECONDS
# PURPOSE:      Maximum allowed clock skew for webhook timestamp replay attack defense
# REQUIRED FOR: Webhook intake security
# TYPE:         NON-SECRET (integer seconds)
# SOURCE:       .env (default: 300)
TELEPHONY_WEBHOOK_TOLERANCE_SECONDS=300

# VARIABLE:     TELEPHONY_MAX_AUDIO_QUEUE_SIZE
# PURPOSE:      Bounded buffer capacity for inbound/outbound audio queues per session
# REQUIRED FOR: Realtime WebSocket Gateway
# TYPE:         NON-SECRET (integer)
# SOURCE:       .env (default: 100)
TELEPHONY_MAX_AUDIO_QUEUE_SIZE=100

# VARIABLE:     TELEPHONY_SESSION_TIMEOUT_SECONDS
# PURPOSE:      Inactivity timeout before an idle session is pruned
# REQUIRED FOR: Realtime Session Manager
# TYPE:         NON-SECRET (integer seconds)
# SOURCE:       .env (default: 1800)
TELEPHONY_SESSION_TIMEOUT_SECONDS=1800

# VARIABLE:     TELEPHONY_MAX_SESSION_DURATION_SECONDS
# PURPOSE:      Absolute hard lifetime cap for any individual phone call
# REQUIRED FOR: Realtime Session Manager
# TYPE:         NON-SECRET (integer seconds)
# SOURCE:       .env (default: 3600)
TELEPHONY_MAX_SESSION_DURATION_SECONDS=3600

# VARIABLE:     TELEPHONY_MAX_ACTIVE_SESSIONS
# PURPOSE:      Maximum concurrent active voice calls supported by this gateway node
# REQUIRED FOR: Gateway Concurrency Shield
# TYPE:         NON-SECRET (integer)
# SOURCE:       .env (default: 500)
TELEPHONY_MAX_ACTIVE_SESSIONS=500

# VARIABLE:     TELEPHONY_RATE_LIMIT_ENABLED
# PURPOSE:      Toggles sliding-window per-IP rate limiting
# REQUIRED FOR: Connection protection
# TYPE:         NON-SECRET (boolean)
# SOURCE:       .env (default: true)
TELEPHONY_RATE_LIMIT_ENABLED=true

# VARIABLE:     TELEPHONY_RATE_LIMIT_CONNECTIONS_PER_MIN
# PURPOSE:      Maximum WebSocket connection requests per IP per minute
# REQUIRED FOR: Gateway Rate Limiter
# TYPE:         NON-SECRET (integer)
# SOURCE:       .env (default: 60)
TELEPHONY_RATE_LIMIT_CONNECTIONS_PER_MIN=60

# VARIABLE:     TELEPHONY_SESSION_CLEANUP_INTERVAL_SECONDS
# PURPOSE:      Interval for background sweeping daemon to prune expired sessions
# REQUIRED FOR: Realtime Session Manager Background Pruner
# TYPE:         NON-SECRET (integer seconds)
# SOURCE:       .env (default: 30)
TELEPHONY_SESSION_CLEANUP_INTERVAL_SECONDS=30

# VARIABLE:     TELEPHONY_WS_PING_INTERVAL_SECONDS
# PURPOSE:      Interval for proactive gateway ping keepalives to client
# REQUIRED FOR: WebSocket Liveness Supervisor
# TYPE:         NON-SECRET (integer seconds)
# SOURCE:       .env (default: 20)
TELEPHONY_WS_PING_INTERVAL_SECONDS=20

# VARIABLE:     TELEPHONY_WS_PING_TIMEOUT_SECONDS
# PURPOSE:      Timeout for client pong response before marking connection dead
# REQUIRED FOR: WebSocket Liveness Supervisor
# TYPE:         NON-SECRET (integer seconds)
# SOURCE:       .env (default: 10)
TELEPHONY_WS_PING_TIMEOUT_SECONDS=10

# VARIABLE:     TELEPHONY_BACKPRESSURE_DROP_STRATEGY
# PURPOSE:      Queue overflow strategy ('drop_oldest' or 'reject')
# REQUIRED FOR: Realtime Audio Buffering
# TYPE:         NON-SECRET (string)
# SOURCE:       .env (default: drop_oldest)
TELEPHONY_BACKPRESSURE_DROP_STRATEGY=drop_oldest

# VARIABLE:     TELEPHONY_MAX_AUDIO_FRAME_SIZE_BYTES
# PURPOSE:      Maximum payload size for an individual audio frame (default: 64KB)
# REQUIRED FOR: Audio Frame Ingestion Validation
# TYPE:         NON-SECRET (integer bytes)
# SOURCE:       .env (default: 65536)
TELEPHONY_MAX_AUDIO_FRAME_SIZE_BYTES=65536

# VARIABLE:     TELEPHONY_MAX_MESSAGE_SIZE_BYTES
# PURPOSE:      Maximum total WebSocket text/binary frame message size (default: 128KB)
# REQUIRED FOR: Inbound WebSocket Receiver Loop
# TYPE:         NON-SECRET (integer bytes)
# SOURCE:       .env (default: 131072)
TELEPHONY_MAX_MESSAGE_SIZE_BYTES=131072

# VARIABLE:     TELEPHONY_DEFAULT_COUNTRY_CODE
# PURPOSE:      Default country code for Indian phone number normalization (+91)
# REQUIRED FOR: Phone number validation
# TYPE:         NON-SECRET (string)
# SOURCE:       .env (default: +91)
TELEPHONY_DEFAULT_COUNTRY_CODE=+91


# ==============================================================================
# 3. VOICE ENGINE TRANSPORT CONFIGURATION (CONTRACT v1.0)
# ==============================================================================
# VARIABLE:     TELEPHONY_VOICE_ENGINE_WS_URL (alias: VOICE_ENGINE_WS_URL)
# PURPOSE:      WebSocket endpoint URL for downstream Voice Engine
# REQUIRED FOR: Voice Engine Transport Integration
# TYPE:         NON-SECRET (URL)
# LOCAL DEV:    ws://localhost:8000/ws/voice
# PRODUCTION:   wss://voice-test.gentechs.in/ws/voice
TELEPHONY_VOICE_ENGINE_WS_URL=ws://localhost:8000/ws/voice

# VARIABLE:     TELEPHONY_VOICE_ENGINE_SAMPLE_RATE (alias: VOICE_ENGINE_SAMPLE_RATE)
# PURPOSE:      Audio sample rate in Hz (16000 preferred, 8000 supported)
# REQUIRED FOR: Voice Engine audio streaming
# TYPE:         NON-SECRET (integer Hz)
TELEPHONY_VOICE_ENGINE_SAMPLE_RATE=16000

# VARIABLE:     TELEPHONY_VOICE_ENGINE_CONNECT_TIMEOUT_SECONDS
# PURPOSE:      Timeout in seconds for establishing WebSocket connection
# REQUIRED FOR: Voice Engine Transport Client
# TYPE:         NON-SECRET (float seconds)
TELEPHONY_VOICE_ENGINE_CONNECT_TIMEOUT_SECONDS=5.0

# VARIABLE:     TELEPHONY_VOICE_ENGINE_INIT_TIMEOUT_SECONDS
# PURPOSE:      Timeout in seconds to wait for session.ready from Voice Engine
# REQUIRED FOR: Voice Engine Transport Client
# TYPE:         NON-SECRET (float seconds)
TELEPHONY_VOICE_ENGINE_INIT_TIMEOUT_SECONDS=5.0

# VARIABLE:     TELEPHONY_VOICE_ENGINE_ENABLED
# PURPOSE:      Master toggle to enable/disable Voice Engine WebSocket bridge
# REQUIRED FOR: Gateway Runtime
# TYPE:         NON-SECRET (boolean)
TELEPHONY_VOICE_ENGINE_ENABLED=true


# ==============================================================================
# 4. EXOTEL TELECOM CARRIER CONFIGURATION
# ==============================================================================
# VARIABLE:     EXOTEL_ACCOUNT_SID
# PURPOSE:      Exotel Account SID identifier
# REQUIRED FOR: Exotel API authentication and webhook routing
# TYPE:         NON-SECRET (identifier)
EXOTEL_ACCOUNT_SID=

# VARIABLE:     EXOTEL_API_KEY
# PURPOSE:      Exotel API Key
# REQUIRED FOR: Exotel API authentication
# TYPE:         SECRET
EXOTEL_API_KEY=

# VARIABLE:     EXOTEL_API_TOKEN
# PURPOSE:      Exotel API Token
# REQUIRED FOR: Exotel API authentication
# TYPE:         SECRET
EXOTEL_API_TOKEN=

# VARIABLE:     EXOTEL_BASE_URL
# PURPOSE:      Exotel REST API Base URL
# REQUIRED FOR: Exotel API calls
# TYPE:         NON-SECRET (URL)
EXOTEL_BASE_URL=https://api.in.exotel.com

# VARIABLE:     EXOTEL_EXOPHONE
# PURPOSE:      Exotel virtual number assigned for inbound/outbound calls
# REQUIRED FOR: Exotel telephony routing
# TYPE:         NON-SECRET
EXOTEL_EXOPHONE=


# ==============================================================================
# 5. OUTBOUND CALL ORCHESTRATION & IDEMPOTENCY CONFIGURATION
# ==============================================================================
# VARIABLE:     TELEPHONY_OUTBOUND_IDEMPOTENCY_STORE_PATH
# PURPOSE:      Filesystem path for persistent SQLite idempotency store (survives restarts)
# REQUIRED FOR: Frozen Contract 2 (Outbound Job/Call ID & Idempotency Enforcement)
# TYPE:         NON-SECRET (filepath)
# DEFAULT:      data/outbound_idempotency.db
TELEPHONY_OUTBOUND_IDEMPOTENCY_STORE_PATH=data/outbound_idempotency.db



