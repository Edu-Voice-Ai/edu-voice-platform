# Edu-Voice-AI Voice Engine Environment Variables Template
# Copy this file to .env and configure provider keys.

# Environment
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server Config
HOST=0.0.0.0
PORT=8000

# Primary AI Providers
SARVAM_API_KEY=
ELEVENLABS_API_KEY=

# Model Configurations
LLM_MODEL=sarvam-105b-conversations
LLM_PROVIDER=sarvam
STT_PROVIDER=sarvam
TTS_PROVIDER=sarvam
VAD_PROVIDER=silero

# Audio Defaults
SAMPLE_RATE=16000
CHANNELS=1
FRAME_DURATION_MS=20

# RAG & Tools Configuration
RAG_ENDPOINT=http://localhost:8000/api/v1/rag
RAG_USE_MOCK=true

# Exotel Telephony Configuration
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_BASE_URL=https://api.exotel.com
EXOTEL_EXOPHONE=
PUBLIC_VOICE_WS_URL=
